<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Avalonia 12 поддерживает на Android только .NET 10. Уровень 36 — тот,
      под который собран сам пакет Avalonia.Android 12.1.5.
    -->
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>EyetrackerGlasses.Android</RootNamespace>
    <AssemblyName>EyetrackerGlasses.Android</AssemblyName>
    <ApplicationId>com.companyname.EyetrackerGlasses</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EnableMnnNative Condition="'$(EnableMnnNative)' == ''">true</EnableMnnNative>
    <RuntimeIdentifiers Condition="'$(AndroidDeviceRid)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(AndroidDeviceRid)' != ''">$(AndroidDeviceRid)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.5" />
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.7" />
    <!-- 1.2.0.3 — первая версия со сборкой под net10.0-android36.0.
         Нужна из-за атрибута postSplashScreenTheme в Resources/values-v31/styles.xml. -->
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
  </ItemGroup>

  <!--
    Выравнивание семейства AndroidX.Lifecycle.
    Без этих ссылок восстановление выдаёт по девять предупреждений NU1608:
    SplashScreen 1.2.0.3 тянет AppCompat.AppCompatResources 1.7.1.4 -> Core 1.19.0.1
    -> Lifecycle.Common 2.11.0.1, тогда как пакеты Lifecycle 2.10.0.2 (из AppCompat
    1.7.1.3, который приходит с Avalonia.Android) требуют строго [2.10.0.2, 2.10.1).
    Прямые ссылки поднимают всё семейство до согласованной 2.11.0.1.
    Строки можно убрать, когда Avalonia.Android и SplashScreen сойдутся на одной
    версии AndroidX.Core — проверяется обычным восстановлением.
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyetrackerGlasses\EyetrackerGlasses.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AndroidNativeRoot Condition="'$(AndroidNativeRoot)' == ''">$(MSBuildThisFileDirectory)../artifacts/android/runtimes</AndroidNativeRoot>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="$(AndroidNativeRoot)/android-arm64/native/*.so"
                          Abi="arm64-v8a" Condition="'$(AndroidDeviceRid)' != 'android-x64'" />
    <AndroidNativeLibrary Include="$(AndroidNativeRoot)/android-x64/native/*.so"
                          Abi="x86_64" Condition="'$(AndroidDeviceRid)' != 'android-arm64'" />
    <AndroidAsset Include="$(AndroidNativeRoot)/android-arm64/native/*-LICENSE.txt"
                  Link="Licenses/%(Filename)%(Extension)" Condition="'$(AndroidDeviceRid)' != 'android-x64'" />
    <AndroidAsset Include="$(AndroidNativeRoot)/android-x64/native/*-LICENSE.txt"
                  Link="Licenses/%(Filename)%(Extension)" Condition="'$(AndroidDeviceRid)' == 'android-x64'" />
  </ItemGroup>

  <Target Name="CheckEyetrackerAndroidNative" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(AndroidDeviceRid)' != 'android-x64' and
                      (!Exists('$(AndroidNativeRoot)/android-arm64/native/liblsl.so') or
                       !Exists('$(AndroidNativeRoot)/android-arm64/native/libOpenCvSharpExtern.so'))"
           Text="Build ARM64 Android native libraries using native/android/build.py --rid android-arm64." />
    <Error Condition="'$(AndroidDeviceRid)' != 'android-arm64' and
                      (!Exists('$(AndroidNativeRoot)/android-x64/native/liblsl.so') or
                       !Exists('$(AndroidNativeRoot)/android-x64/native/libOpenCvSharpExtern.so'))"
           Text="Build x64 Android native libraries using native/android/build.py --rid android-x64." />
  </Target>

  <Import Project="..\build\Mnn.Native.targets" />
</Project>
