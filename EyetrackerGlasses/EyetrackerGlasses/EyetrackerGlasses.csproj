<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EyetrackerGlasses</RootNamespace>
    <AssemblyName>EyetrackerGlasses</AssemblyName>
    <!--
      Компилируемые привязки проверяются на этапе сборки, а не в среде выполнения.
      В Avalonia 12 это значение по умолчанию; оставлено явным, чтобы поведение
      не зависело от версии пакета.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(MnnModelPath)' != ''">
    <AvaloniaResource Include="$(MnnModelPath)" Link="Assets/Models/Detector.mnn" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Платформенные пакеты (Avalonia.Desktop, .Android, .iOS, .Browser)
      подключаются в точках входа, а не здесь: иначе голова Android тянула бы
      настольные серверы вывода, которые под неё не собираются.
    -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <!-- Диалоги: AvaloniaDialogs тянет DialogHost.Avalonia как зависимость. -->
    <PackageReference Include="AvaloniaDialogs" Version="3.7.1" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API" Version="4.0.0.1" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt11.0.cuda13.2.cudnn9.22.Bridge" Version="4.0.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <!-- Иконки Font Awesome: Optris — поддерживаемый преемник Projektanker. -->
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Средства разработчика Avalonia подключаются только в отладочной сборке. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyetrackerGlasses.Core\EyetrackerGlasses.Core.csproj" />
    <ProjectReference Include="..\EyetrackerGlasses.Mnn\EyetrackerGlasses.Mnn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\AI\YoloUtils\" />
  </ItemGroup>

</Project>
